{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NeuroLang",
  "scopeName": "source.neurolang",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#delimiters"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.neurolang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.neurolang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.neurolang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.neurolang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.neurolang",
          "match": "\\b(if|else|while|return)\\b"
        },
        {
          "name": "keyword.declaration.neurolang",
          "match": "\\b(function|let)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.neurolang",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.neurolang",
          "match": "\\bnull\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.neurolang"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.neurolang",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.neurolang",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.neurolang",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.comparison.neurolang",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.neurolang",
          "match": "(=)"
        },
        {
          "name": "keyword.operator.arithmetic.neurolang",
          "match": "(\\+|\\-|\\*|/|%)"
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.separator.delimiter.neurolang",
          "match": "(;|,)"
        },
        {
          "name": "punctuation.section.brackets.neurolang",
          "match": "(\\{|\\}|\\[|\\]|\\(|\\))"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.neurolang",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
